# Variables de Entorno para TechLab Solutions

# Configuración del servidor
PORT=5000

# Conexión a MongoDB
# Reemplaza con tu cadena de conexión a MongoDB
MONGO_URI=mongodb://localhost:27017/techlab

# Secreto para JSON Web Token (JWT)
# Cambia esto por una cadena de caracteres larga y segura
JWT_SECRET=tu_secreto_jwt_muy_seguro

# Configuración de MinIO (o servicio compatible con S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=techlab
MINIO_USE_SSL=false

# Secreto para la sesión de Express (usado por passport)
# Cambia esto por una cadena de caracteres larga y segura
SESSION_SECRET=tu_secreto_de_sesion_muy_seguro

# Configuración de OpenID Connect (OIDC)
# Reemplaza con los detalles de tu proveedor OIDC
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/users/login/oidc/callback

# URL del frontend para redirecciones después de la autenticación OIDC
FRONTEND_URL=http://localhost:3000
